listening-port=${TURN_PORT}
tls-listening-port=${TURN_TLS_PORT}
listening-ip=0.0.0.0
relay-ip=${TURN_RELAY}
external-ip=${PUBLIC_IPV4}/${TURN_RELAY}
min-port=${TURN_RELAY_MIN}
max-port=${TURN_RELAY_MAX}
realm=${RTC_DOMAIN}
server-name=${RTC_DOMAIN}
userdb=/var/lib/coturn/turndb
pidfile=/var/lib/coturn/turnserver.pid
fingerprint
use-auth-secret
static-auth-secret=${TURN_SECRET}
cert=/tls/fullchain.pem
pkey=/tls/privkey.pem
no-tlsv1
no-tlsv1_1
no-dtls
no-cli
no-multicast-peers
no-rfc5780
no-software-attribute
no-tcp-relay
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
# Relay targets the public VPS address, not Docker/private services.
user-quota=12
total-quota=120
stale-nonce=600
log-file=stdout
simple-log
log-min-level=info
