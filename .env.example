# Domains: lowercase, no scheme. MATRIX_DOMAIN is the permanent account identity.
MATRIX_DOMAIN=matrix.cateam.online
ELEMENT_DOMAIN=chat.cateam.online
RTC_DOMAIN=rtc.cateam.online
LETSENCRYPT_EMAIL=admin@cateam.online
PUBLIC_IPV4=
# Local IPv4 if the VPS is behind provider NAT; empty means PUBLIC_IPV4.
TURN_RELAY_IPV4=
IMAGE_PREFIX=ghcr.io/owner/repository
IMAGE_TAG=main
COMPOSE_PROJECT_NAME=matrix
FEDERATION_ENABLED=false
MAX_UPLOAD_MB=50
MIN_FREE_DISK_GB=5
HTTP_PORT=80
HTTPS_PORT=443
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_START=7882
LIVEKIT_UDP_END=7883
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_MIN=49160
TURN_RELAY_MAX=49359
# Generated by make init. Never commit .env or runtime/.
POSTGRES_PASSWORD=
REGISTRATION_SECRET=
MACAROON_SECRET=
FORM_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_SECRET=
RTC_AS_TOKEN=
RTC_HS_TOKEN=
